{
  "name": "noonflow",
  "version": "0.5.1",
  "private": true,
  "author": "allen.cao",
  "description": "Desktop workspace for local Claude Code and Codex sessions",
  "main": "dist-electron/main.js",
  "scripts": {
    "native:ensure": "node scripts/ensure-native-modules.mjs",
    "dev": "npm run native:ensure && node scripts/next-safe.mjs dev",
    "build": "node scripts/next-safe.mjs build",
    "start": "npm run native:ensure && node scripts/next-safe.mjs start",
    "postinstall": "node scripts/postinstall-native-rebuild.mjs",
    "lint": "eslint . --max-warnings 0",
    "check:large-files": "bash scripts/check-large-files.sh",
    "electron:build:main": "tsc -p electron/tsconfig.json && cp -r electron/icons dist-electron/",
    "electron:run:dev": "npm run electron:build:main && NODE_ENV=development electron .",
    "electron:dev": "npm run native:ensure && concurrently -k \"node scripts/next-safe.mjs dev -p 3000\" \"wait-on tcp:127.0.0.1:3000 && npm run electron:run:dev\"",
    "dev:3001": "npm run native:ensure && node scripts/next-safe.mjs dev -p 3001",
    "electron:dev:3001": "npm run native:ensure && concurrently -k \"node scripts/next-safe.mjs dev -p 3001\" \"wait-on tcp:127.0.0.1:3001 && npm run electron:run:dev\"",
    "electron:start": "npm run native:ensure && npm run electron:build:main && npm run electron:prepare && npm run electron:native:rebuild:standalone && npm run electron:native:preflight && NODE_ENV=production electron .",
    "electron:prepare": "node scripts/next-safe.mjs build && node scripts/prepare-electron-resources.mjs",
    "electron:prepare:resources": "node scripts/prepare-electron-resources.mjs",
    "electron:native:rebuild:standalone": "node scripts/rebuild-standalone-native-modules.mjs",
    "electron:native:rebuild:standalone:arm64": "NOONFLOW_TARGET_ARCH=arm64 node scripts/rebuild-standalone-native-modules.mjs",
    "electron:native:rebuild:standalone:x64": "NOONFLOW_TARGET_ARCH=x64 node scripts/rebuild-standalone-native-modules.mjs",
    "electron:native:preflight": "node scripts/verify-electron-native-modules.mjs",
    "electron:native:preflight:arm64": "NOONFLOW_TARGET_ARCH=arm64 node scripts/verify-electron-native-modules.mjs",
    "electron:native:preflight:x64": "NOONFLOW_TARGET_ARCH=x64 node scripts/verify-electron-native-modules.mjs",
    "electron:build": "npm run electron:build:main && npm run electron:prepare && npm run electron:native:rebuild:standalone && npm run electron:native:preflight && NOONFLOW_NOTARIZE=0 electron-builder",
    "electron:verify:mac:local-env": "node scripts/verify-macos-local-build-ready.mjs",
    "electron:mac:release:preflight": "node scripts/verify-macos-release-ready.mjs",
    "electron:verify:mac:distribution": "node scripts/verify-macos-distribution.mjs",
    "electron:verify:mac:launch": "node scripts/verify-macos-packaged-launch.mjs",
    "electron:build:mac:arm64:local": "npm run electron:verify:mac:local-env && npm run electron:build:main && npm run electron:prepare && npm run electron:native:rebuild:standalone:arm64 && npm run electron:native:preflight:arm64 && NOONFLOW_NOTARIZE=0 electron-builder --mac --arm64 && npm run electron:verify:mac:distribution && npm run electron:verify:mac:launch",
    "electron:build:mac:x64:local": "npm run electron:verify:mac:local-env && npm run electron:build:main && npm run electron:prepare && npm run electron:native:rebuild:standalone:x64 && npm run electron:native:preflight:x64 && NOONFLOW_NOTARIZE=0 electron-builder --mac --x64 && npm run electron:verify:mac:distribution && npm run electron:verify:mac:launch",
    "electron:build:mac:arm64": "npm run electron:build:mac:arm64:local",
    "electron:build:mac:x64": "npm run electron:build:mac:x64:local",
    "electron:build:mac": "npm run electron:build:mac:$(node -p \"process.arch === 'arm64' ? 'arm64' : 'x64'\")",
    "electron:build:mac:local": "npm run electron:build:mac:$(node -p \"process.arch === 'arm64' ? 'arm64' : 'x64'\"):local",
    "electron:build:mac:release:arm64": "npm run electron:mac:release:preflight && NOONFLOW_NOTARIZE=1 npm run electron:build:mac:arm64:local",
    "electron:build:mac:release:x64": "npm run electron:mac:release:preflight && NOONFLOW_NOTARIZE=1 npm run electron:build:mac:x64:local",
    "electron:build:mac:release": "npm run electron:build:mac:release:$(node -p \"process.arch === 'arm64' ? 'arm64' : 'x64'\")",
    "electron:smoke": "npm run electron:build:main && npm run electron:prepare && npm run electron:native:rebuild:standalone && npm run electron:native:preflight && node scripts/electron-smoke-check.mjs",
    "electron:port-audit": "node scripts/electron-cold-port-audit.mjs",
    "electron:verify:artifacts": "node scripts/verify-electron-artifacts.mjs && node scripts/verify-external-cli-packaging.mjs",
    "db:migrate": "jiti scripts/db-migrate.ts",
    "chat:replay:validate": "jiti scripts/chat-replay-validate.ts",
    "chat:mainline-gate": "node scripts/chat-mainline-gate.mjs",
    "chat:runtime-long-gate": "node scripts/chat-runtime-long-session-gate.mjs",
    "chat:rollback-drill": "node scripts/chat-rollback-drill.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "npm run native:ensure && node scripts/run-unit-tests.mjs && npm run typecheck",
    "test:unit:full": "node scripts/run-unit-tests.mjs --full"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.47",
    "@ai-sdk/google": "^3.0.31",
    "@ai-sdk/openai": "^3.0.34",
    "@anthropic-ai/claude-agent-sdk": "0.3.226",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/legacy-modes": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@hugeicons/core-free-icons": "^3.1.1",
    "@hugeicons/react": "^1.1.4",
    "@lezer/highlight": "^1.2.3",
    "@openai/codex-sdk": "0.147.0",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@streamdown/cjk": "^1.0.1",
    "@streamdown/code": "^1.0.1",
    "@streamdown/math": "^1.0.1",
    "@streamdown/mermaid": "^1.0.1",
    "@tanstack/react-query": "^5.90.21",
    "@xterm/addon-fit": "^0.11.0",
    "ai": "^6.0.73",
    "ansi-to-react": "^6.2.6",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.563.0",
    "markdown-it": "^14.1.1",
    "motion": "^12.33.0",
    "nanoid": "^5.1.6",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.22.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.1.0",
    "tailwind-merge": "^3.4.0",
    "use-stick-to-bottom": "^1.1.2",
    "xterm": "^5.3.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.58.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "concurrently": "^9.2.1",
    "electron": "40.10.6",
    "electron-builder": "26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "wait-on": "^9.0.4"
  },
  "overrides": {
    "ansi-to-react": {
      "linkify-it": "6.1.0"
    }
  }
}
